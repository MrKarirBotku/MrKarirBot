APP_NAME=MrKarirBot
ENVIRONMENT=development

# Generate a unique value for every environment. Never commit production secrets.
SECRET_KEY=replace-with-a-long-random-secret

# PostgreSQL / Supabase connection string for server-side use only.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mrkarirbot

# Redis connection string for cache and background jobs.
REDIS_URL=redis://localhost:6379/0

# Configure these values in the deployment platform's secret manager.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://your-domain.example/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_ID=@MrKarirAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

JOB_SYNC_INTERVAL_MINUTES=30
JOB_PUBLISH_BATCH_SIZE=10

RATE_LIMIT=60/minute
